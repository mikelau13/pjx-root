FROM node:18-alpine

WORKDIR /app

# Copy package files
# .npmrc carries legacy-peer-deps=true, required for the Apollo Client 2 /
# graphql 15 peer conflict. Without it the RUN below fails with ERESOLVE.
COPY package*.json .npmrc ./

# Install dependencies
RUN npm install

# Install development tools
RUN npm install -g nodemon

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Start development server
CMD ["npm", "start"]