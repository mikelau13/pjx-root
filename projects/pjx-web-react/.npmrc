# @apollo/react-hooks@3.1.5 declares peer graphql@^14.3.1 while this project
# uses graphql@^15.3.0. npm 6 (which wrote package-lock.json) ignored peer
# conflicts; npm 7+ enforces them. Relax it to npm 6 semantics.
# Proper fix is migrating the Apollo Client 2 stack to @apollo/client v3 —
# tracked as follow-up, not in scope for the devcontainer work.
legacy-peer-deps=true
