!/projects/.gitkeep

.DS_Store
.vscode
*.ldb

# Development container files that may contain local settings
.devcontainer/docker-compose.override.yml
.devcontainer/.env

# Node modules in projects
projects/*/node_modules/
projects/*/npm-debug.log*
projects/*/yarn-debug.log*
projects/*/yarn-error.log*

# .NET build outputs in projects
projects/*/bin/
projects/*/obj/
projects/*/.vs/

# Environment files
projects/*/.env
projects/*/.env.local

# Local TLS material (Phase 2). mkcert generates a per-machine CA, so none of
# this is shareable: without rootCA-key.pem nobody else can sign with this CA,
# and without the leaf key Traefik cannot serve it. Everyone runs mkcert
# locally — see docs/architecture-upgrade/phase-2-traefik.md step 3.
local/central-router/config/ca/
local/central-router/config/cert/

# C# extension workspace-scan cache. Regenerated automatically; contains
# container-absolute paths and a workspace hash. Anchored with a leading slash
# so it cannot match projects/pjx-api-dotnet/.
/dotnet/